<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TaskTwig.Controls">
    <Design.PreviewWith>
        <Border Padding="20">
            <controls:EmojiTextBox Text="🖥️"/>
        </Border>
    </Design.PreviewWith>

    <Style Selector="controls|EmojiTextBox">
        <Setter Property="Theme" Value="{StaticResource {x:Type TextBox}}"/>
        
        <Setter Property="FontFamily" Value="{DynamicResource NotoColorEmoji}"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="MaxLength" Value="1"/>
        <Setter Property="MaxWidth" Value="56"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
</Styles>
