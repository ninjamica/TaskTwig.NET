<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:TaskTwig"
             xmlns:semi="https://irihi.tech/semi"
             x:Class="TaskTwig.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>    

    <Application.Styles>
        <FluentTheme />
        <semi:SemiTheme Locale="en-US" />
        <semi:UrsaSemiTheme Locale="en-US"/>
        <StyleInclude Source="/Controls/Styles/TodayTaskBlock.axaml"/>
    </Application.Styles>
             
     <Application.Resources>
         <ResourceDictionary >
             <FontFamily x:Key="NotoColorEmoji">avares://TaskTwig/Assets/Fonts/NotoColorEmoji_WindowsCompatible.ttf#Noto Color Emoji</FontFamily>
             <ResourceDictionary.MergedDictionaries>
                 <ResourceInclude Source="/Controls/ControlThemes/TodayTaskCatBox.axaml"/>
                 <ResourceInclude Source="/Controls/ControlThemes/WeekDaySelect.axaml"/>
             </ResourceDictionary.MergedDictionaries>
         </ResourceDictionary>
     </Application.Resources>
</Application>