<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="using:TaskTwig.Views"
                    xmlns:twigInterval="clr-namespace:TaskTwig.Core.TwigInterval">
    <Design.PreviewWith>
        <views:WeekDaySelect WeekDayMap="{x:Static twigInterval:DayOfWeekFlag.Tuesday}"/>
    </Design.PreviewWith>

    <ControlTheme x:Key="{x:Type views:WeekDaySelect}" TargetType="views:WeekDaySelect">

        <Setter Property="Template">
            <ControlTemplate TargetType="views:WeekDaySelect">
                <Border CornerRadius="{DynamicResource ButtonCornerRadius}" 
                        ClipToBounds="True">
                    <UniformGrid Rows="1" Columns="7">
                        <views:WeekDayButton Day="{x:Static twigInterval:DayOfWeekFlag.Monday}"
                                             WeekDayMap="{TemplateBinding WeekDayMap, Mode=TwoWay}"
                                             Content="M"
                                             CornerRadius="0"
                                             HorizontalAlignment="Stretch"
                                             Padding="8"/>
                        <views:WeekDayButton Day="{x:Static twigInterval:DayOfWeekFlag.Tuesday}"
                                             WeekDayMap="{TemplateBinding WeekDayMap, Mode=TwoWay}"
                                             Content="Tu"
                                             CornerRadius="0"
                                             HorizontalAlignment="Stretch"
                                             Padding="8"/>
                        <views:WeekDayButton Day="{x:Static twigInterval:DayOfWeekFlag.Wednesday}"
                                             WeekDayMap="{TemplateBinding WeekDayMap, Mode=TwoWay}"
                                             Content="W"
                                             CornerRadius="0"
                                             HorizontalAlignment="Stretch"
                                             Padding="8"/>
                        <views:WeekDayButton Day="{x:Static twigInterval:DayOfWeekFlag.Thursday}"
                                             WeekDayMap="{TemplateBinding WeekDayMap, Mode=TwoWay}"
                                             Content="Th"
                                             CornerRadius="0"
                                             HorizontalAlignment="Stretch"
                                             Padding="8"/>
                        <views:WeekDayButton Day="{x:Static twigInterval:DayOfWeekFlag.Friday}"
                                             WeekDayMap="{TemplateBinding WeekDayMap, Mode=TwoWay}"
                                             Content="F"
                                             CornerRadius="0"
                                             HorizontalAlignment="Stretch"
                                             Padding="8"/>
                        <views:WeekDayButton Day="{x:Static twigInterval:DayOfWeekFlag.Saturday}"
                                             WeekDayMap="{TemplateBinding WeekDayMap, Mode=TwoWay}"
                                             Content="Sa"
                                             CornerRadius="0"
                                             HorizontalAlignment="Stretch"
                                             Padding="8"/>
                        <views:WeekDayButton Day="{x:Static twigInterval:DayOfWeekFlag.Sunday}"
                                             WeekDayMap="{TemplateBinding WeekDayMap, Mode=TwoWay}"
                                             Content="Su"
                                             CornerRadius="0"
                                             HorizontalAlignment="Stretch"
                                             Padding="8"/>
                    </UniformGrid></Border>
            </ControlTemplate>
        </Setter>
        
        <Style Selector="^ /template/ views|WeekDayButton">
            <Setter Property="Theme" Value="{StaticResource {x:Type ToggleButton}}"/>
        </Style>

    </ControlTheme>

</ResourceDictionary>

