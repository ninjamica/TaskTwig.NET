<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:controls="clr-namespace:TaskTwig.Controls"
             xmlns:vm="clr-namespace:TaskTwig.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="TaskTwig.Views.NotesView"
             x:DataType="vm:MainViewModel">
    
    <u:UrsaGroupBox Name="NotesGroupBox" 
                    Padding="4, 10, 4, 4"
                    Margin="30"
                    Background="{DynamicResource SemiColorBackground1}"
                    BorderBrush="{DynamicResource SemiColorBorder}"
                    BorderThickness="2"
                    VerticalAlignment="Stretch">
        <u:UrsaGroupBox.Transitions>
            <Transitions>
                <ThicknessTransition Property="Margin" Duration="0:0:0" />
            </Transitions>
        </u:UrsaGroupBox.Transitions>
        <u:UrsaGroupBox.Header>
            <Button Content="{Binding SelectedNote?.Title, TargetNullValue=Select Note}"
                    FontSize="20"
                    Command="{Binding ShowNotesDrawerCommand}"/>
        </u:UrsaGroupBox.Header>
        <ScrollViewer Name="NoteScrollViewer">
            <controls:MarkdownTextBox Markdown="{Binding SelectedNote?.Text, Delay=500}"
                                      PlaceholderText="Type note here..."/>
        </ScrollViewer>
    </u:UrsaGroupBox>
    
</UserControl>
