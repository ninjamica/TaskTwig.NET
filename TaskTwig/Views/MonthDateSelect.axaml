<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:views="clr-namespace:TaskTwig.Views"
             xmlns:vm="clr-namespace:TaskTwig.ViewModels"
             mc:Ignorable="d" d:DesignWidth="315" d:DesignHeight="160"
             x:Class="TaskTwig.Views.MonthDateSelect"
             x:DataType="vm:MonthDateSelectViewModel">
    
    <ItemsControl x:Name="DatesControl">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <u:VirtualizingUniformGrid Columns="7"
                                           ItemWidth="45"
                                           UniformItemHeight="False"/>
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <ToggleButton Content="{Binding}"
                              HorizontalAlignment="Stretch"
                              CornerRadius="0"
                              IsCheckedChanged="DateCheckChanged"/>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
    
</UserControl>
