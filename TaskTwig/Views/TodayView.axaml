<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:views="clr-namespace:TaskTwig.Views"
             xmlns:controls="clr-namespace:TaskTwig.Controls"
             xmlns:core="clr-namespace:TaskTwig.Core"
             xmlns:vm="clr-namespace:TaskTwig.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="TaskTwig.Views.TodayView"
             x:DataType="vm:MainViewModel"
             Name="RootControl">
    
    <ScrollViewer BringIntoViewOnFocusChange="False"
                  u:ScrollTo.Direction="Top">
        <StackPanel>
            <u:UrsaGroupBox Margin="10" Padding="15, 5, 15, 5"
                            Background="{DynamicResource SemiColorBackground1}"
                            BorderBrush="{DynamicResource SemiColorBorder}"
                            BorderThickness="2">
                <u:ButtonGroup>
                    <Button Command="{Binding SleepButtonCommand}">
                        <Button.Content>
                            <MultiBinding Converter="{x:Static views:TodayView.TodaySleepButtonTextConverter}">
                                <Binding Path="IsSleeping"/>
                                <Binding Path="IsDaytime"/>
                                <Binding Path="HasSleepRecordLastNight"/>
                            </MultiBinding>
                        </Button.Content>
                        <Button.IsEnabled>
                            <MultiBinding Converter="{x:Static views:TodayView.TodaySleepButtonEnabledConverter}">
                                <Binding Path="IsSleeping"/>
                                <Binding Path="IsDaytime"/>
                            </MultiBinding>
                        </Button.IsEnabled>
                    </Button>
                    <Button Command="{Binding CancelSleepCommand}"
                            IsVisible="{Binding IsSleeping}">
                        <PathIcon Data="{StaticResource SemiIconDelete}"/>
                    </Button>
                    <Button Command="{Binding SleepAddButtonCommand}">
                        <PathIcon Data="{StaticResource SemiIconPlus}"
                                  Width="12" Height="12"/>
                        <Button.IsVisible>
                            <MultiBinding Converter="{x:Static views:TodayView.TodayAddSleepButtonVisibleConverter}">
                                <Binding Path="IsSleeping"/>
                                <Binding Path="IsDaytime"/>
                                <Binding Path="HasSleepRecordLastNight"/>
                            </MultiBinding>
                        </Button.IsVisible>
                    </Button>
                </u:ButtonGroup>
            </u:UrsaGroupBox>
            <ItemsRepeater ItemsSource="{Binding TaskCategoriesView}">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate DataType="core:TaskCategory">
                        <controls:TodayTaskCatBox TasksSource="{Binding TodayTasks}" 
                                               HeaderText="{Binding Name}"
                                               HeaderIcon="{Binding Icon}"
                                               IsExpanded="{Binding Expanded}"
                                               EditTaskCommand="{Binding #RootControl.((vm:MainViewModel)DataContext).EditTaskCommand}"
                                               Margin="10"
                                               IsVisible="{Binding TodayTasks.Count}">
                            <controls:TodayTaskCatBox.HeaderContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Edit"
                                              Command="{Binding #RootControl.((vm:MainViewModel)DataContext).EditTaskCategoryCommand}"
                                              CommandParameter="{Binding}">
                                        <MenuItem.Icon>
                                            <PathIcon Data="{StaticResource SemiIconEdit}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Add Task"
                                              Command="{Binding #RootControl.((vm:MainViewModel)DataContext).CreateTaskCommand}"
                                              CommandParameter="{Binding}">
                                        <MenuItem.Icon>
                                            <PathIcon Data="{StaticResource SemiIconPlus}"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Add Task to Top"
                                              Command="{Binding #RootControl.((vm:MainViewModel)DataContext).CreateTaskAtTopCommand}"
                                              CommandParameter="{Binding}">
                                        <MenuItem.Icon>
                                            <PathIcon Data="{StaticResource SemiIconAlignTop}"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </controls:TodayTaskCatBox.HeaderContextMenu>
                        </controls:TodayTaskCatBox>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
            <controls:TodayTaskCatBox TasksSource="{Binding DoneTodayTasks}" 
                                   HeaderText="Done"
                                   IsExpanded="{Binding TodayDoneExpanded}"
                                   EditTaskCommand="{Binding EditTaskCommand}"
                                   Margin="10"
                                   IsVisible="{Binding DoneTodayTasks.Count}"/>
        </StackPanel>
    </ScrollViewer>
    
</UserControl>
