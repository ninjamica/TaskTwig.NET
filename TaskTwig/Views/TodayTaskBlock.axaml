<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:TaskTwig.Views"
        xmlns:core="clr-namespace:TaskTwig.Core">
    
    <Style Selector="controls|TodayTaskBlock">

        <Setter Property="Theme" Value="{StaticResource {x:Type CheckBox}}"/>
        
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="IsChecked" Value="{Binding $self.BoundTask?.IsDone}"/>
        <Setter Property="Content" Value="{Binding $self.BoundTask}"/>

        <Setter Property="ContentTemplate">
            <DataTemplate DataType="core:TwTask">
                <Grid ColumnDefinitions="Auto, *, Auto"
                      Margin="5,0,0,0"
                      x:DataType="core:TwTask">
                    <TextBlock Grid.Column="0"
                               Text="{Binding Icon, Converter={x:Static controls:MainView.AppendEmojiSelectorConverter}}"
                               FontSize="24"
                               FontFamily="{StaticResource NotoColorEmoji}"
                               VerticalAlignment="Center"
                               Margin="0,0,5,0"
                               IsVisible="{Binding Icon, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding Name}"
                               FontSize="16"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2"
                               Text="{Binding Interval, Converter={x:Static controls:TodayTaskBlock.TaskInfoTextConverter}}"
                               Foreground="{DynamicResource SemiColorText3}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="5,0,0,0">
                        <TextBlock.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="$self.Text"
                                         Converter="{x:Static StringConverters.IsNotNullOrEmpty}"/>
                                <Binding Path="!IsDone"/>
                            </MultiBinding>
                        </TextBlock.IsVisible>
                    </TextBlock>
                </Grid>
            </DataTemplate>
        </Setter>
        
        
        <Style Selector="^:pointerover">
            <Style Selector="^ TextBlock">
                <Setter Property="TextDecorations" Value="Underline"/>
            </Style>
        </Style>
        
        <Style Selector="^:checked">
            <Style Selector="^ TextBlock">
                <Setter Property="TextDecorations" Value="Strikethrough"/>
                <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}"/>
            </Style>
        </Style>
        
        <Style Selector="^:checked:pointerover">
            <Style Selector="^ TextBlock">
                <Setter Property="TextDecorations" Value="Strikethrough Underline"/>
                <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}"/>
            </Style>
        </Style>
        
    </Style>
</Styles>
