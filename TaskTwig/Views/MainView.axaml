<UserControl xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:vm="using:TaskTwig.ViewModels"
                xmlns:u="https://irihi.tech/ursa"
                xmlns:sortable="clr-namespace:Sortable.Avalonia;assembly=Sortable.Avalonia"
                xmlns:core="clr-namespace:TaskTwig.Core"
                xmlns:views="clr-namespace:TaskTwig.Views"
                mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="700"
                x:Class="TaskTwig.Views.MainView"
                x:DataType="vm:MainViewModel">
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    
    <Panel>
        <TabbedPage x:Name="TabControl" IsKeyboardNavigationEnabled="True">
            
            <ContentPage Header="Today" Icon="{StaticResource SemiIconCalendar}">
                <ScrollViewer>
                    <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="Auto, *" ColumnSpacing="5">
                        <ItemsRepeater Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" 
                                       ItemsSource="{Binding TaskCategoriesView}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Grid RowDefinitions="Auto, *" ColumnDefinitions="Auto, *" ColumnSpacing="5">
                                        <views:ExpanderButton Grid.Row="0" Grid.Column="0"
                                                              IsExpanded="{Binding Expanded}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" VerticalAlignment="Center"
                                                   Text="{Binding Name}"
                                                   FontSize="16"/>
                                        <ItemsRepeater Grid.Row="1" Grid.Column="1" ItemsSource="{Binding TodayTasks}"
                                                       Margin="0, 5, 0, 10"
                                                       IsVisible="{Binding Expanded}">
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsDone, Mode=OneWay}"
                                                              Command="{Binding SetDoneCommand}"
                                                              CommandParameter="{Binding $self.IsChecked}"
                                                              Content="{Binding Name}"/>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <views:ExpanderButton Grid.Row="1" Grid.Column="0"
                                              IsExpanded="{Binding TodayDoneExpanded}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Done" FontSize="16" VerticalAlignment="Center"/>
                        <ItemsRepeater Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" 
                                       ItemsSource="{Binding DoneTodayTasks}"
                                       Margin="10, 5, 0, 10"
                                       IsVisible="{Binding TodayDoneExpanded}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <CheckBox IsChecked="{Binding IsDone, Mode=OneWay}"
                                                  Command="{Binding SetDoneCommand}"
                                                  CommandParameter="{Binding $self.IsChecked}">
                                            <TextBlock Text="{Binding Name}"
                                                       TextDecorations="Strikethrough"
                                                       Classes="Tertiary"/>
                                        </CheckBox>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </Grid>
                </ScrollViewer>
            </ContentPage>
            
            <ContentPage Header="Tasks" Icon="{StaticResource SemiIconCheckList}">
                <ScrollViewer x:Name="TasksScrollViewer" 
                              PointerReleased="TaskDragEnded"
                              ScrollGestureEnded="TaskScrollEnded">
                    <ScrollViewer.GestureRecognizers>
                        <ScrollGestureRecognizer CanVerticallyScroll="True"
                                                 CanHorizontallyScroll="True"/>
                    </ScrollViewer.GestureRecognizers>
                    <StackPanel Spacing="10" Margin="10">
                    <ItemsControl ItemsSource="{Binding TaskCategoriesView}"
                                  sortable:Sortable.Sortable="True" 
                                  sortable:Sortable.Droppable="False"
                                  sortable:Sortable.Group="categories"
                                  sortable:Sortable.UpdateCommand="{Binding #TabControl.((vm:MainViewModel)DataContext).CategoryListUpdateCommand}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid RowSpacing="5" ColumnSpacing="5" Margin="5, 10, 5, 10"
                                      RowDefinitions="Auto, *, Auto" ColumnDefinitions="Auto, Auto, *"
                                      sortable:Sortable.IsSortable="True">
                                    <PathIcon Grid.Row="0" Grid.Column="0"
                                              Data="{StaticResource SemiIconHandle}"
                                              Cursor="Hand"
                                              PointerPressed="TaskDragStarted"
                                              ScrollGesture="TaskScrollStarted"/>
                                    <views:ExpanderButton Grid.Row="0" Grid.Column="1"
                                                          IsExpanded="{Binding Expanded}"/>
                                    <Button Grid.Row="0" Grid.Column="2" HorizontalAlignment="Left"
                                            Content="{Binding Name}"
                                            Command="{Binding #TabControl.((vm:MainViewModel)DataContext).EditTaskCategoryCommand}"
                                            CommandParameter="{Binding}"
                                            Theme="{DynamicResource OutlineButton}"/>
                                    
                                    <ItemsControl Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                  ItemsSource="{Binding Tasks}"
                                                  IsVisible="{Binding Expanded}"
                                                  sortable:Sortable.IsSortable="True"
                                                  sortable:Sortable.Droppable="True"
                                                  sortable:Sortable.Group="tasks"
                                                  sortable:Sortable.UpdateCommand="{Binding #TabControl.((vm:MainViewModel)DataContext).TaskListUpdateCommand}"
                                                  sortable:Sortable.DropCommand="{Binding #TabControl.((vm:MainViewModel)DataContext).TaskListDropCommand}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal"
                                                            sortable:Sortable.IsSortable="True"
                                                            sortable:Sortable.IsDroppable="True">
                                                    <PathIcon Data="{StaticResource SemiIconHandle}"
                                                              Cursor="Hand"
                                                              PointerPressed="TaskDragStarted"
                                                              ScrollGesture="TaskScrollStarted"/>
                                                    <Button Content="{Binding Name}"
                                                            Classes="Tertiary"
                                                            Theme="{DynamicResource BorderlessButton}"
                                                            Command="{Binding #TabControl.((vm:MainViewModel)DataContext).EditTaskCommand}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" 
                                            Command="{Binding #TabControl.((vm:MainViewModel)DataContext).CreateTaskCommand}" 
                                            CommandParameter="{Binding}" 
                                            Margin="20, 0, 0, 0"
                                            Content="Add Task+"
                                            IsVisible="{Binding Expanded}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Command="{Binding CreateTaskCategory}"
                            Content="Add Task Category+"/>
                </StackPanel>
                </ScrollViewer>
            </ContentPage>
            
            <ContentPage Header="Sleep" Icon="{StaticResource SemiIconAlarm}">
                <ScrollViewer>
                <StackPanel>
                    <u:ButtonGroup>
                        <Button x:Name="SleepButton" 
                                Content="{Binding SleepButtonText}"
                                Command="{Binding OnSleepButton}"/>
                        <Button Content="+" Command="{Binding OnSleepAddButton}"/>
                    </u:ButtonGroup>
                    <ListBox ItemsSource="{Binding SleepList}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0}: slept from {1:t} to {2:t} for {3:F1} hours">
                                            <Binding Path="Key"></Binding>
                                            <Binding Path="Value.StartTime"></Binding>
                                            <Binding Path="Value.EndTime"></Binding>
                                            <Binding Path="Value.Length.TotalHours"></Binding>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
                </ScrollViewer>
            </ContentPage>
            
            <ContentPage Header="Journal" Icon="{StaticResource SemiIconBook}">
                <u:UrsaGroupBox Margin="30"
                                Padding="4, 10, 4, 4"
                                Background="{DynamicResource SemiColorBackground1}"
                                BorderBrush="{DynamicResource SemiColorBackground2}">
                    <u:UrsaGroupBox.Header>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="Journal:"
                                       Classes="H4"
                                       Theme="{StaticResource TitleTextBlock}"/>
                            <TextBlock Text="{Binding DailyJournalDate}"
                                       Classes="H6 Secondary"
                                       Theme="{StaticResource TitleTextBlock}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </u:UrsaGroupBox.Header>
                    <TextBox Text="{Binding DailyJournal}"
                             PlaceholderText="Daily Journal" 
                             AcceptsReturn="True" 
                             AcceptsTab="True" 
                             TextWrapping="Wrap"
                             VerticalAlignment="Stretch"
                             VerticalContentAlignment="Top"
                             TextInputOptions.ReturnKeyType="Return"
                             Theme="{StaticResource LooklessTextBox}"
                             Foreground="{DynamicResource SemiColorText1}"/>
                </u:UrsaGroupBox>
            </ContentPage>
            
            <ContentPage Header="Notes" Icon="{StaticResource SemiIconEdit2}">
                <Grid Margin="20" ColumnSpacing="20" ColumnDefinitions="*, Auto" RowDefinitions="Auto, *">
                    <u:UrsaGroupBox Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                                    Padding="4, 10, 4, 4"
                                    Background="{DynamicResource SemiColorBackground1}"
                                    BorderBrush="{DynamicResource SemiColorBackground2}">
                        <u:UrsaGroupBox.Header>
                            <TextBox Text="{Binding SelectedNote.Title}"/>
                        </u:UrsaGroupBox.Header>
                        <StackPanel>
                            <TextBox Text="{Binding SelectedNote.Text}" 
                                     PlaceholderText="Type Note Here"
                                     AcceptsReturn="True"
                                     AcceptsTab="True" 
                                     TextWrapping="Wrap"
                                     VerticalAlignment="Stretch"
                                     VerticalContentAlignment="Top"
                                     TextInputOptions.ReturnKeyType="Return"
                                     Theme="{StaticResource LooklessTextBox}"
                                     Foreground="{DynamicResource SemiColorText1}"/>
                        </StackPanel>
                    </u:UrsaGroupBox>
                    
                    <ScrollViewer Grid.Row="0" Grid.Column="1">
                        <TabStrip ItemsSource="{Binding Notes}"
                                  SelectedItem="{Binding SelectedNote}">
                            <TabStrip.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"/>
                                </ItemsPanelTemplate>
                            </TabStrip.ItemsPanel>
                            <TabStrip.ItemTemplate>
                                <DataTemplate DataType="core:Note">
                                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                                        <Button Content="x" 
                                                Classes="Danger"
                                                Command="{Binding #TabControl.((vm:MainViewModel)DataContext).DeleteNoteCommand}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </TabStrip.ItemTemplate>
                        </TabStrip>
                    </ScrollViewer>
                    
                    <Button Grid.Row="1" Grid.Column="1" VerticalAlignment="Top"
                            Content="+" 
                            Command="{Binding CreateNote}"/>
                </Grid>
            </ContentPage>
            
            <ContentPage Header="Settings" Icon="{StaticResource SemiIconSetting}">
                <StackPanel Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding DbxAccountName}"/>
                    <Button Content="DbxSignIn" Command="{Binding DbxSignIn}"/>
                    <u:IconButton Content="Save" 
                                  Command="{Binding SaveFiles}"
                                  IsLoading="{Binding IsSaveFilesLoading}"/>
                    <u:IconButton Content="Backup" 
                                  Command="{Binding BackupFiles}"
                                  IsLoading="{Binding IsBackupFilesLoading}"/>
                    <u:IconButton Content="Push" 
                                  Command="{Binding PushDbx}" 
                                  IsLoading="{Binding IsPushDbxLoading}"/>
                    <u:IconButton Content="Pull" 
                                  Command="{Binding PullDbx}"
                                  IsLoading="{Binding IsPullDbxLoading}"/>
                    <u:IconButton Content="Sync" 
                                  Command="{Binding DbxSync}"
                                  IsLoading="{Binding IsSyncDbxLoading}"/>
                </StackPanel>
            </ContentPage>                                      
            
        </TabbedPage>
        <u:OverlayDialogHost Name="DialogHost"/>
    </Panel>
</UserControl>
