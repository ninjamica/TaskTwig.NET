<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:TaskTwig.ViewModels"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:sortable="clr-namespace:Sortable.Avalonia;assembly=Sortable.Avalonia"
             xmlns:core="clr-namespace:TaskTwig.Core"
             xmlns:views="clr-namespace:TaskTwig.Views"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="700"
             x:Class="TaskTwig.Views.MainView"
             x:DataType="vm:MainViewModel"
             x:Name="RootControl">
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    
    <Panel>
        <DockPanel>
            <CommandBar DockPanel.Dock="{OnFormFactor Bottom, Mobile=Top}">
                <CommandBar.Content>
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="10,0,0,0">
                        <Panel>
                            <u:LoadingIcon x:Name="SyncLoadingIcon">
                                <u:LoadingIcon.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                        <Binding Path="SaveFilesCommand.IsRunning" />
                                        <Binding Path="DbxSyncCommand.IsRunning" />
                                        <Binding Path="PullDbxCommand.IsRunning" />
                                        <Binding Path="PushDbxCommand.IsRunning" />
                                        <Binding Path="FetchDbxCommand.IsRunning" />
                                    </MultiBinding>
                                </u:LoadingIcon.IsVisible>
                            </u:LoadingIcon>
                            <PathIcon Data="{StaticResource SemiIconCheckCircleStroked}"
                                      Foreground="{DynamicResource SemiColorSuccess}">
                                <PathIcon.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="InSync"/>
                                        <Binding Path="!#SyncLoadingIcon.IsVisible" />
                                    </MultiBinding>
                                </PathIcon.IsVisible>
                            </PathIcon>
                            <Panel>
                                <Panel.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="!InSync"/>
                                        <Binding Path="!#SyncLoadingIcon.IsVisible" />
                                    </MultiBinding>
                                </Panel.IsVisible>
                                
                            </Panel>
                            <PathIcon Data="{StaticResource SemiIconUnChainStroked}"
                                      Foreground="{DynamicResource SemiColorWarning}">
                                <PathIcon.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="!#SyncLoadingIcon.IsVisible" />
                                        <Binding Path="!InSync"/>
                                        <Binding Path="CacheValid"/>
                                    </MultiBinding>
                                </PathIcon.IsVisible>
                            </PathIcon>
                            <PathIcon Data="{StaticResource SemiIconCrossCircleStroked}"
                                      Foreground="{DynamicResource SemiColorWarning}">
                                <PathIcon.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="!#SyncLoadingIcon.IsVisible" />
                                        <Binding Path="!CacheValid"/>
                                    </MultiBinding>
                                </PathIcon.IsVisible>
                            </PathIcon>
                        </Panel>
                        <TextBlock Text="{Binding SyncStatusText}"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </CommandBar.Content>
                <CommandBar.PrimaryCommands>
                    <CommandBarButton Label="Sync" Icon="{StaticResource SemiIconSync}"
                                      Command="{Binding DbxSyncCommand}"/>
                </CommandBar.PrimaryCommands>
                <CommandBar.SecondaryCommands>
                    <CommandBarButton Label="Compare To Cloud" Icon="{StaticResource SemiIconCloud}"
                                      Command="{Binding FetchDbxCommand}"/>
                    <CommandBarButton Label="Upload All" Icon="{StaticResource SemiIconUpload}"
                                      Command="{Binding PushDbxCommand}"/>
                    <CommandBarButton Label="Download All" Icon="{StaticResource SemiIconDownload}"
                                      Command="{Binding PullDbxCommand}"/>
                    <CommandBarButton Label="Save Locally" Icon="{StaticResource SemiIconSave}"
                                      Command="{Binding SaveFilesCommand}"/>
                </CommandBar.SecondaryCommands>
            </CommandBar>
            
            <TabbedPage x:Name="TabControl" IsKeyboardNavigationEnabled="True">
                <ContentPage Header="Today" Icon="{StaticResource SemiIconCalendar}">
                    <ScrollViewer BringIntoViewOnFocusChange="True"
                                  u:ScrollTo.Direction="Top">
                        <StackPanel>
                            <u:UrsaGroupBox Margin="10" Padding="15, 5, 15, 5"
                                            Background="{DynamicResource SemiColorBackground1}"
                                            BorderBrush="{DynamicResource SemiColorBorder}"
                                            BorderThickness="2">
                                <u:ButtonGroup>
                                    <Button Command="{Binding SleepButtonCommand}">
                                        <Button.Content>
                                            <MultiBinding Converter="{x:Static views:MainView.TodaySleepButtonTextConverter}">
                                                <Binding Path="IsSleeping"/>
                                                <Binding Path="IsDaytime"/>
                                                <Binding Path="HasSleepRecordLastNight"/>
                                            </MultiBinding>
                                        </Button.Content>
                                        <Button.IsEnabled>
                                            <MultiBinding Converter="{x:Static views:MainView.TodaySleepButtonEnabledConverter}">
                                                <Binding Path="IsSleeping"/>
                                                <Binding Path="IsDaytime"/>
                                            </MultiBinding>
                                        </Button.IsEnabled>
                                    </Button>
                                    <Button Command="{Binding CancelSleepCommand}"
                                            IsVisible="{Binding IsSleeping}">
                                        <PathIcon Data="{StaticResource SemiIconDelete}"/>
                                    </Button>
                                    <Button Command="{Binding SleepAddButtonCommand}">
                                        <PathIcon Data="{StaticResource SemiIconPlus}"
                                                  Width="12" Height="12"/>
                                        <Button.IsVisible>
                                            <MultiBinding Converter="{x:Static views:MainView.TodayAddSleepButtonVisibleConverter}">
                                                <Binding Path="IsSleeping"/>
                                                <Binding Path="IsDaytime"/>
                                                <Binding Path="HasSleepRecordLastNight"/>
                                            </MultiBinding>
                                        </Button.IsVisible>
                                    </Button>
                                </u:ButtonGroup>
                            </u:UrsaGroupBox>
                            <ItemsRepeater ItemsSource="{Binding TaskCategoriesView}">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate DataType="core:TaskCategory">
                                        <views:TodayTaskCatBox TasksSource="{Binding TodayTasks}" 
                                                               HeaderText="{Binding Name}"
                                                               IsExpanded="{Binding Expanded}"
                                                               EditTaskCommand="{Binding #RootControl.((vm:MainViewModel)DataContext).EditTaskCommand}"
                                                               Margin="10"
                                                               IsVisible="{Binding TodayTasks.Count}">
                                            <views:TodayTaskCatBox.HeaderContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Edit"
                                                              Command="{Binding #TabControl.((vm:MainViewModel)DataContext).EditTaskCategoryCommand}"
                                                              CommandParameter="{Binding}">
                                                        <MenuItem.Icon>
                                                            <PathIcon Data="{StaticResource SemiIconEdit}" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Add Task"
                                                              Command="{Binding #TabControl.((vm:MainViewModel)DataContext).CreateTaskCommand}"
                                                              CommandParameter="{Binding}">
                                                        <MenuItem.Icon>
                                                            <PathIcon Data="{StaticResource SemiIconPlus}"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </views:TodayTaskCatBox.HeaderContextMenu>
                                        </views:TodayTaskCatBox>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                            <views:TodayTaskCatBox TasksSource="{Binding DoneTodayTasks}" 
                                                   HeaderText="Done"
                                                   IsExpanded="{Binding TodayDoneExpanded}"
                                                   EditTaskCommand="{Binding EditTaskCommand}"
                                                   Margin="10"
                                                   IsVisible="{Binding DoneTodayTasks.Count}"/>
                        </StackPanel>
                    </ScrollViewer>
                </ContentPage>
            
                <ContentPage Header="Tasks" Icon="{StaticResource SemiIconCheckList}"
                             Loaded="LoadedTasksPage">
                    <ScrollViewer x:Name="TaskScrollViewer"
                                  BringIntoViewOnFocusChange="True"
                                  u:ScrollTo.Direction="Top">
                        <Grid RowDefinitions="*,Auto,Auto" ColumnDefinitions="*,*,*"
                              RowSpacing="10" Margin="10"
                              VerticalAlignment="Top">
                            
                            <UniformGrid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" 
                                         Columns="1"
                                         RowSpacing="10"
                                         Margin="20, 10, 5, 10"
                                         IsVisible="{Binding !GetTaskCategoriesAsync^?.Count, FallbackValue=True, TargetNullValue=True}">
                                <u:Skeleton CornerRadius="6"
                                            Height="36"
                                            Width="200"
                                            HorizontalAlignment="Left"
                                            IsLoading="True"/>
                                <u:Skeleton CornerRadius="6"
                                            Height="36"
                                            Width="240"
                                            HorizontalAlignment="Left"
                                            IsLoading="True"/>
                                <u:Skeleton CornerRadius="6"
                                            Height="36"
                                            Width="180"
                                            HorizontalAlignment="Left"
                                            IsLoading="True"/>
                                <u:Skeleton CornerRadius="6"
                                            Height="36"
                                            Width="260"
                                            HorizontalAlignment="Left"
                                            IsLoading="True"/>
                                <u:Skeleton CornerRadius="6"
                                            Height="36"
                                            Width="230"
                                            HorizontalAlignment="Left"
                                            IsLoading="True"/>
                                <u:Skeleton CornerRadius="6"
                                            Height="36"
                                            Width="200"
                                            HorizontalAlignment="Left"
                                            IsLoading="True"/>
                                <u:Skeleton CornerRadius="6"
                                            Height="36"
                                            Width="240"
                                            HorizontalAlignment="Left"
                                            IsLoading="True"/>
                                <u:Skeleton CornerRadius="6"
                                            Height="36"
                                            Width="180"
                                            HorizontalAlignment="Left"
                                            IsLoading="True"/>
                                <u:Skeleton CornerRadius="6"
                                            Height="36"
                                            Width="260"
                                            HorizontalAlignment="Left"
                                            IsLoading="True"/>
                                <u:Skeleton CornerRadius="6"
                                            Height="36"
                                            Width="230"
                                            HorizontalAlignment="Left"
                                            IsLoading="True"/>
                            </UniformGrid>
                                
                            <ItemsControl Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                          ItemsSource="{Binding TasksFlatList}"
                                          IsVisible="{Binding !#RootControl.IsReorderCategories}"
                                          sortable:Sortable.Sortable="True"
                                          sortable:Sortable.AutoScroll="True"
                                          sortable:Sortable.UpdateCommand="{Binding TaskListUpdateCommand}"
                                          sortable:Sortable.ReleaseCommand="{Binding TaskListReleaseCommand}">
                                
                                <ItemsControl.DataTemplates>
                                    
                                    <DataTemplate DataType="vm:TaskCategoryListItem">
                                        <Grid RowDefinitions="*, Auto" RowSpacing="10"
                                              ColumnDefinitions="Auto, Auto, *" ColumnSpacing="5"
                                              Margin="10, 10, 5, 10">
                                            <PathIcon Grid.Row="0" Grid.Column="0"
                                                      Data="{StaticResource SemiIconHandle}"
                                                      IsVisible="{Binding #RootControl.IsReorderCategories}"
                                                      Cursor="Hand"
                                                      sortable:Sortable.IsDragHandle="True"
                                                      PointerPressed="CategoryDragStarted" />
                                            <views:ExpanderButton Grid.Row="0" Grid.Column="0"
                                                                  IsExpanded="{Binding Category.Expanded}"
                                                                  Padding="3,0,5,0" />
                                            <Button Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left"
                                                    Command="{Binding #TabControl.((vm:MainViewModel)DataContext).EditTaskCategoryCommand}"
                                                    CommandParameter="{Binding Category}"
                                                    Theme="{DynamicResource OutlineButton}"
                                                    Classes="Tertiary"
                                                    Padding="12,4">
                                                <TextBlock FontSize="{StaticResource SemiFontSizeHeader5}">
                                                    <!-- <Run Text="{Binding Icon}" -->
                                                    <!--      FontFamily="{StaticResource NotoColorEmoji}" -->
                                                    <!--      FontSize="24" /> -->
                                                    <Run Text="{Binding Category.Name}"
                                                         BaselineAlignment="Center" />
                                                    <InlineUIContainer
                                                        BaselineAlignment="Center">
                                                        <PathIcon
                                                            Data="{StaticResource SemiIconMore}"
                                                            Width="16"
                                                            RenderTransform="rotate(90deg) translate(5px, 0px)" />
                                                    </InlineUIContainer>
                                                </TextBlock>
                                            </Button>
                                            <Button Grid.Row="0" Grid.Column="2"
                                                    Foreground="White"
                                                    Background="Transparent"
                                                    Margin="0"
                                                    HorizontalAlignment="Left"
                                                    Command="{Binding #TabControl.((vm:MainViewModel)DataContext).CreateTaskCommand}"
                                                    CommandParameter="{Binding Category}"
                                                    IsVisible="{Binding !#RootControl.IsReorderCategories}">
                                                <PathIcon Data="{StaticResource SemiIconPlus}"
                                                          Width="10" Height="10" />
                                            </Button>
                                            <u:Divider Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"/>
                                            <Grid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Edit"
                                                              Command="{Binding #TabControl.((vm:MainViewModel)DataContext).EditTaskCategoryCommand}"
                                                              CommandParameter="{Binding Category}">
                                                        <MenuItem.Icon>
                                                            <PathIcon Data="{StaticResource SemiIconEdit}" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Add Task">
                                                        <MenuItem.Icon>
                                                            <PathIcon Data="{StaticResource SemiIconPlus}" />
                                                        </MenuItem.Icon>
                                                        
                                                        <MenuItem Header="Add to Top"
                                                                  Command="{Binding #TabControl.((vm:MainViewModel)DataContext).CreateTaskAtTopCommand}"
                                                                  CommandParameter="{Binding Category}">
                                                            <MenuItem.Icon>
                                                                <PathIcon Data="{StaticResource SemiIconAlignTop}"/>
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Add to Bottom"
                                                                  Command="{Binding #TabControl.((vm:MainViewModel)DataContext).CreateTaskCommand}"
                                                                  CommandParameter="{Binding Category}">
                                                            <MenuItem.Icon>
                                                                <PathIcon Data="{StaticResource SemiIconAlignBottom}"/>
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                    </MenuItem>
                                                    <MenuItem Header="Delete Finished Tasks"
                                                              Command="{Binding Category.RemovePermaDoneTasks}"
                                                              Foreground="{DynamicResource SemiColorWarning}">
                                                        <MenuItem.Icon>
                                                            <PathIcon Data="{StaticResource SemiIconTrueFalseStroked}" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Grid.ContextMenu>
                                        </Grid>
                                    </DataTemplate>
                                    
                                </ItemsControl.DataTemplates>
                                
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:TaskListItem">
                                        <Border Theme="{StaticResource CardBorder}"
                                                Classes="Hover"
                                                Margin="30,4,4,4"
                                                Padding="10,4, 3, 4"
                                                HorizontalAlignment="Left"
                                                IsVisible="{Binding Task.Category.Expanded}"
                                                sortable:Sortable.IsSortable="True">
                                            <Grid ColumnDefinitions="Auto,*">
                                                <Panel Grid.Column="0"
                                                       Width="30"
                                                       PointerPressed="TaskDragStarted">
                                                    <PathIcon
                                                        Data="{StaticResource SemiIconHandle}"
                                                        Cursor="Hand"
                                                        HorizontalAlignment="Left" />
                                                </Panel>
        
                                                <Button Grid.Column="1"
                                                        Classes="Tertiary"
                                                        Theme="{DynamicResource BorderlessButton}"
                                                        Command="{Binding #TabControl.((vm:MainViewModel)DataContext).EditTaskCommand}"
                                                        CommandParameter="{Binding Task}"
                                                        Padding="0,0,10,0">
                                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding Task.Icon}"
                                                                   FontFamily="{StaticResource NotoColorEmoji}"
                                                                   FontSize="24"
                                                                   Margin="0,0,5,0"
                                                                   IsVisible="{Binding Task.Icon, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Task.Name}"
                                                                   TextWrapping="Wrap"
                                                                   VerticalAlignment="Center"/>
                                                        <PathIcon Grid.Column="2"
                                                                  Data="{StaticResource SemiIconMore}"
                                                                  Width="16"
                                                                  RenderTransform="rotate(90deg) translate(5px, 0px)"
                                                                  VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Button>
                                                <Grid.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Edit"
                                                                Command="{Binding #TabControl.((vm:MainViewModel)DataContext).EditTaskCommand}"
                                                                CommandParameter="{Binding Task}">
                                                            <MenuItem.Icon>
                                                                <PathIcon Data="{StaticResource SemiIconEdit}"/>
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Move To">
                                                            <MenuItem.Icon>
                                                                <PathIcon Data="{StaticResource SemiIconLineHeight}"/>
                                                            </MenuItem.Icon>
                                                            
                                                            <MenuItem Header="Top of Category"
                                                                      Command="{Binding #RootControl.((vm:MainViewModel)DataContext).MoveTaskToTopCommand}"
                                                                      CommandParameter="{Binding Task}">
                                                                <MenuItem.Icon>
                                                                    <PathIcon Data="{StaticResource SemiIconAlignTop}"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="Bottom of Category"
                                                                      Command="{Binding #RootControl.((vm:MainViewModel)DataContext).MoveTaskToBottomCommand}"
                                                                      CommandParameter="{Binding Task}">
                                                                <MenuItem.Icon>
                                                                    <PathIcon Data="{StaticResource SemiIconAlignBottom}"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                        </MenuItem>
                                                        <MenuItem Header="Move To Category"
                                                                ItemsSource="{Binding #RootControl.((vm:MainViewModel)DataContext).TaskCategoriesView}"
                                                                Command="{Binding $self.((core:TaskCategory)SelectedItem)?.AddTask}"
                                                                CommandParameter="{Binding Task}">
                                                            <MenuItem.Icon>
                                                                <PathIcon Data="{StaticResource SemiIconAppCenter}"/>
                                                            </MenuItem.Icon>
                                                            <MenuItem.ItemTemplate>
                                                                <DataTemplate DataType="core:TaskCategory">
                                                                    <TextBlock Text="{Binding Name}"/>
                                                                </DataTemplate>
                                                            </MenuItem.ItemTemplate>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </Grid.ContextMenu>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            
                            <ItemsControl Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                          ItemsSource="{Binding TaskCategoriesView}"
                                          IsVisible="{Binding #RootControl.IsReorderCategories}"
                                          sortable:Sortable.Sortable="True"
                                          sortable:Sortable.AutoScroll="True"
                                          sortable:Sortable.UpdateCommand="{Binding CategoryListUpdateCommand}"
                                          sortable:Sortable.ReleaseCommand="{Binding CategoryListReleaseCommand}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="5"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="core:TaskCategory">
                                        <Border Theme="{StaticResource CardBorder}"
                                                Classes="Hover"
                                                Padding="10,4, 3, 4"
                                                HorizontalAlignment="Left"
                                                sortable:Sortable.IsSortable="True">
                                            <Grid ColumnSpacing="5"
                                                  ColumnDefinitions="Auto, *">
                                                <PathIcon Grid.Column="0"
                                                          Data="{StaticResource SemiIconHandle}"
                                                          Cursor="Hand"
                                                          PointerPressed="CategoryDragStarted" />
                                                <Button Grid.Column="1" HorizontalAlignment="Left"
                                                        Command="{Binding #TabControl.((vm:MainViewModel)DataContext).EditTaskCategoryCommand}"
                                                        CommandParameter="{Binding}"
                                                        Theme="{DynamicResource OutlineButton}"
                                                        Classes="Tertiary"
                                                        Padding="12,4">
                                                    <TextBlock FontSize="{StaticResource SemiFontSizeHeader5}">
                                                        <!-- <Run Text="{Binding Icon}" -->
                                                        <!--      FontFamily="{StaticResource NotoColorEmoji}" -->
                                                        <!--      FontSize="24" /> -->
                                                        <Run Text="{Binding Name}"
                                                             BaselineAlignment="Center" />
                                                        <InlineUIContainer
                                                            BaselineAlignment="Center">
                                                            <PathIcon
                                                                Data="{StaticResource SemiIconMore}"
                                                                Width="16"
                                                                RenderTransform="rotate(90deg) translate(5px, 0px)" />
                                                        </InlineUIContainer>
                                                    </TextBlock>
                                                </Button>
                                                <Grid.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Edit"
                                                                  Command="{Binding #TabControl.((vm:MainViewModel)DataContext).EditTaskCategoryCommand}"
                                                                  CommandParameter="{Binding }">
                                                            <MenuItem.Icon>
                                                                <PathIcon Data="{StaticResource SemiIconEdit}" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </Grid.ContextMenu>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <u:IconButton Grid.Row="0" Grid.Column="0"
                                          Command="{Binding CreateTaskCategoryCommand}"
                                          Content="Category"
                                          Icon="{StaticResource SemiIconPlus}"
                                          IsVisible="{Binding !#RootControl.IsReorderCategories}" />
                            <u:IconButton Grid.Row="0" Grid.Column="1"
                                          Command="{Binding #RootControl.EnterCategoryReorderCommand}"
                                          Content="Reorder"
                                          Icon="{StaticResource SemiIconLineHeight}"
                                          IsVisible="{Binding !#RootControl.IsReorderCategories}" />
                            <u:IconButton Grid.Row="0" Grid.Column="1"
                                          Command="{Binding #RootControl.ExitCategoryReorderCommand}"
                                          Content="Finish"
                                          Classes="Success"
                                          Icon="{StaticResource SemiIconTick}"
                                          IsVisible="{Binding #RootControl.IsReorderCategories}" />
                            <u:IconButton Grid.Row="0" Grid.Column="2"
                                          Command="{Binding DeletePermaDoneTasksCommand}"
                                          Content="Finished"
                                          Classes="Danger"
                                          Icon="{StaticResource SemiIconDelete}"
                                          IsVisible="{Binding !#RootControl.IsReorderCategories}" />
                        </Grid>
                    </ScrollViewer>
                </ContentPage>
            
                <ContentPage Header="Sleep" Icon="{StaticResource SemiIconAlarm}">
                    <ScrollViewer u:ScrollTo.Direction="Top">
                    <StackPanel>
                        <u:ButtonGroup>
                            <Button Content="{Binding IsSleeping, Converter={x:Static views:MainView.SleepButtonTextConverter}}"
                                    Command="{Binding SleepButtonCommand}"/>
                            <Button Command="{Binding CancelSleepCommand}"
                                    IsVisible="{Binding IsSleeping}">
                                <PathIcon Data="{StaticResource SemiIconDelete}"/>
                            </Button>
                            <Button Command="{Binding SleepAddButtonCommand}"
                                    IsVisible="{Binding !IsSleeping}">
                                <PathIcon Data="{StaticResource SemiIconPlus}"
                                          Width="12" Height="12"/>
                            </Button>
                        </u:ButtonGroup>
                        <ListBox ItemsSource="{Binding SleepList}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="core:Sleep">
                                    <TextBlock>
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0}: slept from {1:t} to {2:t} for {3:F1} hours">
                                                <Binding Path="Date" />
                                                <Binding Path="StartTime" />
                                                <Binding Path="EndTime" />
                                                <Binding Path="Length.TotalHours" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                    </ScrollViewer>
                </ContentPage>
            
                <ContentPage Header="Journal" Icon="{StaticResource SemiIconBook}">
                    <u:UrsaGroupBox x:Name="JournalGroupBox"
                                    Margin="30"
                                    Padding="4, 10, 4, 4"
                                    Background="{DynamicResource SemiColorBackground1}"
                                    BorderBrush="{DynamicResource SemiColorBorder}"
                                    BorderThickness="2"
                                    VerticalAlignment="Stretch">
                        <u:UrsaGroupBox.Transitions>
                            <Transitions>
                                <ThicknessTransition Property="Margin" Duration="0:0:0" />
                            </Transitions>
                        </u:UrsaGroupBox.Transitions>
                        <u:UrsaGroupBox.Header>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="Journal:"
                                           Classes="H4"
                                           Theme="{StaticResource TitleTextBlock}"
                                           VerticalAlignment="Center"/>
                                <Button>
                                    <TextBlock
                                        Text="{Binding SelectedJournal?.Date, Converter={x:Static views:MainView.JournalDateConverter}}"
                                        Classes="H6 Secondary"
                                        Theme="{StaticResource TitleTextBlock}"
                                        VerticalAlignment="Center"/>
                                    <Button.Flyout>
                                        <Flyout>
                                            <Calendar x:Name="JournalCalendar" SelectionMode="SingleDate"
                                                      SelectedDate="{Binding JournalSelectedDate}"
                                                      HorizontalAlignment="Center"/>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </u:UrsaGroupBox.Header>
                        <ScrollViewer>
                            <TextBox Text="{Binding SelectedJournal?.Text, Delay=500}"
                                     PlaceholderText="Daily Journal"
                                     AcceptsReturn="True"
                                     AcceptsTab="True"
                                     TextWrapping="Wrap"
                                     VerticalAlignment="Stretch"
                                     VerticalContentAlignment="Top"
                                     TextInputOptions.ReturnKeyType="Return"
                                     TextInputOptions.AutoCapitalization="True"
                                     Theme="{StaticResource LooklessTextBox}"
                                     Foreground="{DynamicResource SemiColorText1}"/>
                        </ScrollViewer>
                    </u:UrsaGroupBox>
                </ContentPage>
            
                <ContentPage Header="Notes" Icon="{StaticResource SemiIconEdit2}">
                    <u:UrsaGroupBox x:Name="NotesGroupBox" 
                                    Padding="4, 10, 4, 4"
                                    Margin="30"
                                    Background="{DynamicResource SemiColorBackground1}"
                                    BorderBrush="{DynamicResource SemiColorBorder}"
                                    BorderThickness="2"
                                    VerticalAlignment="Stretch">
                        <u:UrsaGroupBox.Transitions>
                            <Transitions>
                                <ThicknessTransition Property="Margin" Duration="0:0:0" />
                            </Transitions>
                        </u:UrsaGroupBox.Transitions>
                        <u:UrsaGroupBox.Header>
                            <!-- <TextBox Text="{Binding SelectedNote?.Title}" -->
                            <!--          AcceptsReturn="False" AcceptsTab="False" -->
                            <!--          FontSize="20" -->
                            <!--          TextInputOptions.AutoCapitalization="True"/> -->
                            <Button Content="{Binding SelectedNote?.Title, TargetNullValue=Select Note}"
                                    FontSize="20"
                                    Command="{Binding ShowNotesDrawerCommand}"/>
                        </u:UrsaGroupBox.Header>
                        <ScrollViewer>
                            <TextBox Text="{Binding SelectedNote?.Text, Delay=500}"
                                     PlaceholderText="Type Note Here"
                                     AcceptsReturn="True"
                                     AcceptsTab="True"
                                     TextWrapping="Wrap"
                                     VerticalAlignment="Stretch"
                                     VerticalContentAlignment="Top"
                                     TextInputOptions.ReturnKeyType="Return"
                                     TextInputOptions.AutoCapitalization="True"
                                     Theme="{StaticResource LooklessTextBox}"
                                     Foreground="{DynamicResource SemiColorText1}"/>
                        </ScrollViewer>
                    </u:UrsaGroupBox>
            
                </ContentPage>
            
                <ContentPage Header="Settings" Icon="{StaticResource SemiIconSetting}">
                    <StackPanel Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <u:Avatar Source="{Binding DbxPhoto^, FallbackValue=Null}"
                                  Content="DBX"
                                  Classes="Large"/>
                        <TextBlock Text="{Binding DbxAccountName, TargetNullValue=No Account}"
                                   TextAlignment="Center"/>
                        <u:IconButton Content="{Binding IsDbxConnected, Converter={x:Static views:MainView.AccountButtonTextConverter}}"
                                      Command="{Binding DbxSignInOutCommand}"
                                      IsLoading="{Binding DbxSignInOutCommand.IsRunning}"/>
                        <u:IconButton Content="Save"
                                      Command="{Binding SaveFilesCommand}"
                                      IsLoading="{Binding SaveFilesCommand.IsRunning}"/>
                        <u:IconButton Content="Push"
                                      Command="{Binding PushDbxCommand}"
                                      IsLoading="{Binding PushDbxCommand.IsRunning}"/>
                        <u:IconButton Content="Pull"
                                      Command="{Binding PullDbxCommand}"
                                      IsLoading="{Binding PullDbxCommand.IsRunning}"/>
                        <u:IconButton Content="Sync"
                                      Command="{Binding DbxSyncCommand}"
                                      IsLoading="{Binding DbxSyncCommand.IsRunning}"
                                      HotKey="Ctrl+S"/>
                        <ToggleSwitch IsChecked="{Binding AutoSync}"
                                      OffContent="Auto Save" OnContent="Auto Sync"/>
                        <u:TimePicker SelectedTime="{Binding DayStart}"
                                      DisplayFormat="h:mm tt" PanelFormat="hh mm tt"/>
                    </StackPanel>
                </ContentPage>
            
            </TabbedPage>
        </DockPanel>
        <u:OverlayDialogHost x:Name="DialogHost"/>
    </Panel>
</UserControl>
