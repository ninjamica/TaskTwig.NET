                <!--         </views:SettingsView.IsVisible> -->
                <!--     </views:SettingsView> -->
                <!-- </Panel> -->
            <!-- </DrawerPage> -->
            </SplitView>

        </DockPanel>
        <u:OverlayDialogHost x:Name="DialogHost" />
    </Panel>
</UserControl>