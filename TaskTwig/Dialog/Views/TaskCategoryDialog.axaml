<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:vm="using:TaskTwig.Dialog.ViewModels"
             xmlns:controls="clr-namespace:TaskTwig.Controls"
             xmlns:core="clr-namespace:TaskTwig.Core"
             x:Class="TaskTwig.Dialog.Views.TaskCategoryDialog"
             x:DataType="vm:TaskCategoryDialogViewModel">
    
    <Design.DataContext>
        <vm:TaskCategoryDialogViewModel>
            <vm:TaskCategoryDialogViewModel.Category>
                <core:TaskCategory AddToTop="False"/>
            </vm:TaskCategoryDialogViewModel.Category>
        </vm:TaskCategoryDialogViewModel>
    </Design.DataContext>
    
    <Grid RowDefinitions="Auto, *, Auto" Margin="25,18,25,25" RowSpacing="10">
        
        <TextBlock Grid.Row="0"
                   Margin="8"
                   FontSize="16"
                   FontWeight="600"
                   Text="Edit Task Category"/>
        
        <u:Form Grid.Row="1" LabelPosition="Left" LabelWidth="*">
            <u:FormItem Label="Name">
                <TextBox Text="{Binding Category?.Name}"
                         AcceptsReturn="False" AcceptsTab="False"
                         TextWrapping="Wrap"
                         TextInputOptions.AutoCapitalization="True"
                         u:FocusHelper.DialogFocusHint="True"/>
            </u:FormItem>
            <u:FormItem Label="Icon">
                <controls:EmojiTextBox Text="{Binding Category?.Icon}"/>
            </u:FormItem>
            <u:FormItem Label="Add New Tasks at">
                <ComboBox>
                    <ComboBoxItem Name="TopComboBoxItem" 
                                  Content="top"
                                  IsSelected="{Binding Category?.AddToTop, Mode=TwoWay}" />
                    <ComboBoxItem Content="bottom"
                                  IsSelected="{Binding !#TopComboBoxItem.IsSelected} "/>
                </ComboBox>
            </u:FormItem>
        </u:Form>
        
        <DockPanel Grid.Row="2">
            
            <Button Command="{Binding Delete}"
                    Classes="Danger"
                    Theme="{StaticResource SolidButton}"
                    HorizontalAlignment="Left"
                    DockPanel.Dock="Left">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{DynamicResource SemiIconDelete}"/>
                    <TextBlock Text="Delete"/>
                </StackPanel>
            </Button>
            
            <Button Content="Okay"
                    Command="{Binding Close}"
                    IsDefault="True"
                    IsCancel="True"
                    Theme="{StaticResource SolidButton}"
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Right"/>
            
        </DockPanel>
        
    </Grid>
    
</UserControl>
